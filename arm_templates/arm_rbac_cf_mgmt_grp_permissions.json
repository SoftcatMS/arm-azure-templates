{
  "$schema": "https://schema.management.azure.com/schemas/2019-08-01/managementGroupDeploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "managementGroupId": {
      "type": "string",
      "metadata": {
        "description": "ID of the management group to assign the role to. If the tenant root group, this will typically be the tenant ID"
      }
    },
    "readerPrincipalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the service principal that will be given Reader access at the defined management group scope"
      }
    }
  },
  "variables": {
    "readerRoleDefinitionId": "/providers/Microsoft.Authorization/roleDefinitions/acdd72a7-3385-48ef-bd42-f606fba81ae7"
  },
  "resources": [
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "name": "[guid(parameters('managementGroupId'), parameters('readerPrincipalId'), variables('readerRoleDefinitionId'))]",
      "scope": "[format('/providers/Microsoft.Management/managementGroups/{0}', parameters('managementGroupId'))]",
      "properties": {
        "roleDefinitionId": "[variables('readerRoleDefinitionId')]",
        "principalId": "[parameters('readerPrincipalId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ]
}